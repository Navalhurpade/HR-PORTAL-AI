# Local PostgreSQL connection string. Do not commit real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_portal
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Optional: for hosted PostgreSQL, point to a provider CA PEM file kept outside version control.
# CA_CERT_PATH=C:\path\to\provider-ca.pem
# Optional local directory for shared company documents. Defaults to ./storage/company-documents.
# COMPANY_DOCUMENTS_DIR=./storage/company-documents
# Required in production: generate a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# AI_PROVIDER selects the chat provider: google (default), groq, openai, nvidia, or lmstudio.
AI_PROVIDER=google

# Required for Gemini chat and company-document embeddings; keep this secret in .env.
GOOGLE_API_KEY=replace-with-your-google-api-key
GOOGLE_MODEL=gemini-3.1-flash-lite
# Set the selected provider's key and optional model instead when using another hosted provider.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=meta-llama-3-8b-instruct

# Optional LangSmith tracing. Traces can include prompts, responses, and retrieved data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nori-local