# Local PostgreSQL connection string. Do not commit real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hr_portal
# For hosted PostgreSQL with a provider CA, point to its PEM file, e.g. ./ca.pem
# CA_CERT_PATH=./ca.pem
HOST=127.0.0.1
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# Required in production: generate a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Required for Nori responses; keep this secret in .env and never commit it.
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional: defaults to llama-3.3-70b-versatile
# GROQ_MODEL=llama-3.3-70b-versatile
